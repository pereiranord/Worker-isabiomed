# Copie estas chaves para Vercel → Project Settings → Environment Variables.
# NENHUM valor real deve ficar neste arquivo nem em nenhum arquivo versionado.

# Airtable — Project Settings → Personal Access Token (ou token de serviço)
# com escopo de leitura na base "isa estetica".
AIRTABLE_PAT=
AIRTABLE_BASE_ID=appJn6FJhobras7Hg

# Cal.com — Settings → Developer → API Keys (chave da conta isabiomed).
CAL_API_KEY=

# URL pública do site em produção (usada no sitemap.xml).
SITE_URL=https://isabiomed.com.br
